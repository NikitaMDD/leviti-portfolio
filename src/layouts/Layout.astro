---
import PlayerBar from '../components/PlayerBar';


interface Props {
    title?: string;
}

const { title = "leviti — performance dj" } = Astro.props

---

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
    />
</head>
<body>
    <slot />
    <PlayerBar client:idle />
</body>
</html>

<style is:global>
    :root {
        /* Дизайн-система */
        --color-burnt-orange: #FE7E3C;
        --color-lust: #E4201B;
        --color-copper: #61413C;
        --color-blue-lagoon: #0E6873;
        --color-black-pearl: #1A2C30;
        --color-blood: #8a1f2b;
        --color-title: #F2EDE9;

        /* типографика */
        --font-display: "Archivo", sans-serif;
        --font-body: "Archivo", sans-serif;
        --font-mono: "JetBrains Mono", monospace;

        /* spacing, база 8px */
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 12px;
        --space-4: 16px;
        --space-5: 24px;
        --space-6: 32px;
        --space-7: 48px;
        --space-8: 64px;
        --space-9: 96px;
        --space-10: 128px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: var(--color-black-pearl);
        color: var(--color-title);
        font-family: var(--font-body);
    }

    section {
        height: 100vh;
    }

</style>