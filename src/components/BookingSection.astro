---
// Секция "Букинг": короткая форма заявки (уходит на почту Оли через
// Web3Forms, см. src/lib/contacts.ts) + прямые контакты. Под формой —
// черновик строки афиши, который собирается из полей по мере заполнения,
// в той же вёрстке, что строки в секции "Ивенты"
import { CONTACTS, WEB3FORMS_KEY } from "../lib/contacts";
import { CITY_CODES } from "../lib/cities";

const FORMATS = ["Клуб", "Бар", "Частное", "Корпоратив", "Фестиваль"];

const links = [
	{ label: "Telegram", value: `@${CONTACTS.telegram}`, href: `https://t.me/${CONTACTS.telegram}` },
	{ label: "Instagram", value: `@${CONTACTS.instagram}`, href: `https://www.instagram.com/${CONTACTS.instagram}/` },
	CONTACTS.telegramChannel && { label: "Канал", value: "Telegram-канал", href: CONTACTS.telegramChannel },
].filter((l): l is { label: string; value: string; href: string } => Boolean(l));
---

<section class="booking" id="booking">
	<!-- data-inner-scroll: на мобильном форма не влезает в экран и
		 скроллится внутри секции, см. innerScrollAllows в index.astro.
		 data-lenis-prevent — остановленный Lenis иначе глушит нативный
		 тач-скролл внутри -->
	<div class="booking__inner" data-inner-scroll data-lenis-prevent>
		<div class="booking__head">
			<h2 class="booking__title">Букинг</h2>
			<p class="booking__lead">
				Клуб, бар, частное или корпоративное событие. Расскажите про ивент —
				отвечу по контакту, который оставите.
			</p>

			<p class="booking__direct-label">Или напишите напрямую</p>
			<ul class="booking__direct">
				{links.map((l) => (
					<li>
						<a href={l.href} target="_blank" rel="noopener">
							<span class="booking__direct-name">{l.label}</span>
							<span class="booking__direct-value">{l.value}</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<form
			class="booking__form"
			id="booking-form"
			data-key={WEB3FORMS_KEY}
			data-telegram={CONTACTS.telegram}
			data-city-codes={JSON.stringify(CITY_CODES)}
		>
			<label class="field">
				<span class="field__label">Дата</span>
				<input class="field__input" type="text" name="date" inputmode="numeric" autocomplete="off" placeholder="ДД.ММ.ГГГГ" maxlength="10" required />
			</label>

			<label class="field">
				<span class="field__label">Город</span>
				<input class="field__input" type="text" name="city" list="booking-cities" placeholder="Москва" required />
				<datalist id="booking-cities">
					{Object.keys(CITY_CODES).map((c) => <option value={c} />)}
				</datalist>
			</label>

			<fieldset class="field field--wide">
				<legend class="field__label">Формат</legend>
				<div class="chips">
					{FORMATS.map((f, i) => (
						<label class="chip">
							<input type="radio" name="format" value={f} required={i === 0} />
							<span>{f}</span>
						</label>
					))}
				</div>
			</fieldset>

			<label class="field">
				<span class="field__label">Площадка или название</span>
				<input class="field__input" type="text" name="venue" placeholder="Необязательно" />
			</label>

			<label class="field">
				<span class="field__label">Ваше имя</span>
				<input class="field__input" type="text" name="name" autocomplete="name" pattern="[^0-9]*" required />
			</label>

			<label class="field field--wide">
				<span class="field__label">Как с вами связаться</span>
				<input class="field__input" type="text" name="contact" placeholder="@telegram, телефон или почта" required />
			</label>

			<label class="field field--wide">
				<span class="field__label">Детали</span>
				<textarea class="field__input field__input--area" name="details" rows="2" placeholder="Время и длительность сета, бюджет, техника на площадке"></textarea>
			</label>

			<!-- ловушка для ботов: людям не видна, Web3Forms отбрасывает заявки, где она отмечена -->
			<input type="checkbox" name="botcheck" class="booking__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

			<div class="field--wide draft" aria-live="polite">
				<span class="draft__label">Ваш ивент в афише</span>
				<div class="draft__row">
					<span class="draft__date" data-draft="date">--.--</span>
					<span class="draft__title" data-draft="venue">Ваш ивент</span>
					<span class="draft__city" data-draft="city">---</span>
					<span class="draft__tag" data-draft="format">формат</span>
				</div>
			</div>

			<div class="field--wide booking__submit-row">
				<button class="booking__submit" type="submit">Отправить заявку</button>
				<p class="booking__status" role="status" data-status></p>
			</div>
		</form>

		<!-- экран успеха: встаёт на место формы после отправки. Строка афиши
			 копируется из черновика формы (см. showDone в <script>) -->
		<div class="booking__done" id="booking-done" tabindex="-1" hidden>
			<span class="draft__label booking__done-label">Отправлено</span>
			<h3 class="booking__done-title">Заявка у меня</h3>
			<p class="booking__done-text">
				Отвечу по контакту, который вы указали: <span class="booking__done-contact" data-done-contact></span>
			</p>
			<div class="draft" data-done-row></div>
			<button class="booking__again" type="button" data-done-again>Отправить ещё одну</button>
		</div>
	</div>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>("#booking-form");

	if (form) {
		const key = form.dataset.key ?? "";
		const telegram = form.dataset.telegram ?? "";
		const cityCodes: Record<string, string> = JSON.parse(form.dataset.cityCodes ?? "{}");
		const status = form.querySelector<HTMLElement>("[data-status]")!;
		const submit = form.querySelector<HTMLButtonElement>(".booking__submit")!;
		const draft = (name: string) => form.querySelector<HTMLElement>(`[data-draft="${name}"]`)!;

		const dateInput = form.elements.namedItem("date") as HTMLInputElement;
		const nameInput = form.elements.namedItem("name") as HTMLInputElement;

		// переписывает значение поля и возвращает каретку на то же место
		// относительно "значимых" символов — иначе при правке в середине она
		// прыгает в конец
		function rewrite(input: HTMLInputElement, format: (v: string) => string, isSignificant: (ch: string) => boolean) {
			const caret = input.selectionStart ?? input.value.length;
			const before = [...input.value.slice(0, caret)].filter(isSignificant).length;
			const next = format(input.value);
			if (next === input.value) return;
			input.value = next;
			let pos = 0;
			for (let seen = 0; pos < next.length && seen < before; pos++) {
				if (isSignificant(next[pos])) seen++;
			}
			input.setSelectionRange(pos, pos);
		}

		const isDigit = (ch: string) => ch >= "0" && ch <= "9";

		// маска даты: вводятся только цифры, точки подставляются сами.
		// Точка появляется вместе со следующей цифрой, а не сразу после
		// второй — так Backspace не упирается в точку
		function formatDate(value: string) {
			const d = value.replace(/\D/g, "").slice(0, 8);
			return [d.slice(0, 2), d.slice(2, 4), d.slice(4)].filter(Boolean).join(".");
		}

		// "ДД.ММ.ГГГГ" -> Date (UTC-полночь) или null, если такой даты нет
		function parseDate(value: string) {
			const m = value.match(/^(\d{2})\.(\d{2})\.(\d{4})$/);
			if (!m) return null;
			const [, dd, mm, yyyy] = m.map(Number);
			const date = new Date(Date.UTC(yyyy, mm - 1, dd));
			return date.getUTCDate() === dd && date.getUTCMonth() === mm - 1 ? date : null;
		}

		function validateDate() {
			const value = dateInput.value;
			const date = parseDate(value);
			const now = new Date();
			const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
			let message = "";
			if (value && value.length < 10) message = "Введите дату полностью: ДД.ММ.ГГГГ";
			else if (value && !date) message = "Такой даты нет";
			else if (date && +date < today) message = "Эта дата уже прошла";
			dateInput.setCustomValidity(message);
		}

		dateInput.addEventListener("input", () => {
			rewrite(dateInput, formatDate, isDigit);
			validateDate();
		});

		// имя — без цифр: они просто не вводятся (и не вставляются)
		nameInput.addEventListener("input", () => {
			rewrite(nameInput, (v) => v.replace(/\d/g, ""), (ch) => !isDigit(ch));
		});

		function updateDraft() {
			const data = new FormData(form!);
			const date = String(data.get("date") ?? "");
			const city = String(data.get("city") ?? "").trim();
			const venue = String(data.get("venue") ?? "").trim();
			const format = String(data.get("format") ?? "");

			// в афише — только ДД.ММ, показываем как только они введены
			setDraft("date", date.length >= 5 ? date.slice(0, 5) : "", "--.--");
			setDraft("venue", venue, "Ваш ивент");
			setDraft("city", cityCodes[city] ?? city, "---");
			setDraft("format", format, "формат");
		}

		// пустое поле — заглушка приглушённым моно, как у неуточнённых ивентов
		function setDraft(name: string, value: string, fallback: string) {
			const el = draft(name);
			el.textContent = value || fallback;
			el.classList.toggle("is-empty", !value);
		}

		form.addEventListener("input", updateDraft);
		updateDraft();

		function setStatus(text: string, tone: "error" | "" = "") {
			status.textContent = text;
			status.dataset.tone = tone;
		}

		const done = document.querySelector<HTMLElement>("#booking-done")!;
		const inner = form.closest<HTMLElement>(".booking__inner");

		// форма уходит, на её месте — подтверждение с той же строкой афиши,
		// что организатор видел в черновике
		function showDone(contact: string) {
			done.querySelector("[data-done-contact]")!.textContent = contact;
			const row = form!.querySelector(".draft__row")!.cloneNode(true);
			done.querySelector("[data-done-row]")!.replaceChildren(row);

			form!.hidden = true;
			done.hidden = false;
			// на мобильном форма длиннее экрана — возвращаем к началу секции,
			// иначе подтверждение окажется выше видимой области
			if (inner) inner.scrollTop = 0;
			done.focus({ preventScroll: true });
		}

		done.querySelector("[data-done-again]")!.addEventListener("click", () => {
			form.reset();
			validateDate();
			updateDraft();
			setStatus("");
			done.hidden = true;
			form.hidden = false;
			dateInput.focus();
		});

		form.addEventListener("submit", async (e) => {
			e.preventDefault();

			if (!key) {
				setStatus(`Форма пока не подключена. Напишите в Telegram @${telegram}.`, "error");
				return;
			}

			const data = new FormData(form);
			const payload = {
				access_key: key,
				subject: `Букинг: ${data.get("date")} · ${data.get("city")} · ${data.get("format")}`,
				from_name: "dj-leviti.ru — заявка на букинг",
				botcheck: data.get("botcheck") ? true : "",
				"Дата": data.get("date"),
				"Город": data.get("city"),
				"Формат": data.get("format"),
				"Площадка": data.get("venue") || "—",
				"Имя": data.get("name"),
				"Контакт": data.get("contact"),
				"Детали": data.get("details") || "—",
			};

			submit.disabled = true;
			setStatus("Отправляю…");

			try {
				const res = await fetch("https://api.web3forms.com/submit", {
					method: "POST",
					headers: { "Content-Type": "application/json", Accept: "application/json" },
					body: JSON.stringify(payload),
				});
				const json = await res.json().catch(() => ({}));
				if (!res.ok || !json.success) throw new Error(json.message || `HTTP ${res.status}`);

				showDone(String(data.get("contact") ?? ""));
			} catch (err) {
				setStatus(`Заявка не отправилась (${(err as Error).message}). Напишите в Telegram @${telegram}.`, "error");
			} finally {
				submit.disabled = false;
			}
		});
	}
</script>

<style>
	.booking__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
		align-items: center;
		gap: var(--space-8);
		height: 100%;
		max-width: 1080px;
		margin: 0 auto;
		padding: var(--space-9) var(--space-6) var(--space-7);
	}

	.booking__title {
		font-family: var(--font-display);
		font-weight: 900;
		text-transform: uppercase;
		line-height: 0.92;
		font-size: clamp(2.75rem, 6vw, 4.75rem);
		margin: 0 0 var(--space-5);
		color: var(--color-title);
	}

	.booking__lead {
		margin: 0 0 var(--space-7);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.6;
		color: #F2EDE9B3;
		max-width: 380px;
	}

	.booking__direct-label,
	.field__label,
	.draft__label {
		display: block;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(242, 237, 233, 0.55);
	}

	.booking__direct-label {
		margin: 0 0 var(--space-3);
	}

	.booking__direct {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgba(242, 237, 233, 0.14);
	}

	.booking__direct a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-4);
		padding: var(--space-3) 0;
		border-bottom: 1px solid rgba(242, 237, 233, 0.14);
		font-family: var(--font-mono);
		font-size: 13px;
		text-decoration: none;
		color: var(--color-title);
		transition: color 0.2s ease;
	}

	.booking__direct-name {
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.booking__direct-value {
		color: var(--color-burnt-orange);
	}

	.booking__direct a:hover {
		color: var(--color-burnt-orange);
	}

	.booking__direct a:focus-visible,
	.booking__submit:focus-visible {
		outline: 2px solid var(--color-title);
		outline-offset: 2px;
	}

	/* форма — две колонки, широкие поля на всю строку */
	.booking__form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-5) var(--space-5);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	.field--wide {
		grid-column: 1 / -1;
	}

	/* legend в gap флекса fieldset не участвует — отступ задаём сами */
	.field__label {
		padding: 0;
	}

	legend.field__label {
		margin-bottom: var(--space-2);
	}

	.field__input {
		width: 100%;
		padding: var(--space-2) 0;
		border: 0;
		border-bottom: 1px solid rgba(242, 237, 233, 0.24);
		border-radius: 0;
		background: transparent;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--color-title);
		color-scheme: dark;
		transition: border-color 0.2s ease;
	}

	.field__input::placeholder {
		color: rgba(242, 237, 233, 0.32);
	}

	.field__input:focus {
		outline: none;
		border-bottom-color: var(--color-burnt-orange);
	}

	.field__input:user-invalid {
		border-bottom-color: var(--color-lust);
	}

	.field__input--area {
		resize: none;
		line-height: 1.5;
	}

	/* формат — те же обводные плашки, что у жанров в "о себе" */
	.chips {
		display: flex;
		flex-wrap: nowrap;
		gap: var(--space-2);
	}

	.chip input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.chip span {
		display: inline-block;
		white-space: nowrap;
		padding: 8px 13px;
		border: 1px solid rgba(254, 126, 60, 0.45);
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-burnt-orange);
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.chip:hover span {
		border-color: var(--color-burnt-orange);
	}

	.chip input:checked + span {
		background: var(--color-burnt-orange);
		border-color: var(--color-burnt-orange);
		color: var(--color-black-pearl);
	}

	.chip input:focus-visible + span {
		outline: 2px solid var(--color-title);
		outline-offset: 2px;
	}

	/* черновик строки афиши — повторяет строку .event из EventsSection */
	.draft {
		margin-top: var(--space-2);
	}

	.draft__row {
		display: grid;
		grid-template-columns: 80px minmax(0, 1fr) 48px auto;
		align-items: center;
		gap: var(--space-4);
		margin-top: var(--space-2);
		padding: var(--space-3) 0;
		border-top: 1px solid rgba(242, 237, 233, 0.14);
		border-bottom: 1px solid rgba(242, 237, 233, 0.14);
	}

	.draft__date {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 22px;
		line-height: 1;
		color: var(--color-burnt-orange);
		font-variant-numeric: tabular-nums;
	}

	.draft__title {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 17px;
		text-transform: uppercase;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.draft__city,
	.draft__tag {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(242, 237, 233, 0.6);
	}

	.draft__tag {
		color: var(--color-burnt-orange);
	}

	.draft .is-empty {
		font-family: var(--font-mono);
		font-weight: 400;
		font-size: 13px;
		letter-spacing: 0.04em;
		color: rgba(242, 237, 233, 0.32);
	}

	.booking__submit-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	.booking__submit {
		padding: 14px 24px;
		border: 0;
		border-radius: 2px;
		background: var(--color-lust);
		font-family: var(--font-mono);
		font-size: 12px;
		text-transform: uppercase;
		color: var(--color-title);
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	.booking__submit:hover {
		background: var(--color-burnt-orange);
	}

	.booking__submit:disabled {
		opacity: 0.6;
		cursor: progress;
	}

	.booking__status {
		flex: 1;
		min-width: 200px;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.5;
		color: rgba(242, 237, 233, 0.7);
	}

	.booking__status[data-tone="error"] {
		color: #ff6a5c;
	}

	.booking__done {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		animation: bookingDoneIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* hidden у flex-элемента иначе перебивается display:flex выше */
	.booking__done[hidden],
	.booking__form[hidden] {
		display: none;
	}

	.booking__done:focus {
		outline: none;
	}

	.booking__done-label {
		color: var(--color-burnt-orange);
	}

	.booking__done-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 900;
		text-transform: uppercase;
		line-height: 0.95;
		font-size: clamp(2rem, 4vw, 3rem);
		color: var(--color-title);
	}

	.booking__done-text {
		margin: 0;
		font-size: 16px;
		font-weight: 500;
		line-height: 1.6;
		color: #F2EDE9B3;
	}

	.booking__done-contact {
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--color-title);
		/* inline-block — контакт сначала переносится на новую строку целиком,
		   и рвётся внутри, только если длиннее строки (длинная почта) */
		display: inline-block;
		max-width: 100%;
		overflow-wrap: anywhere;
	}

	.booking__done .draft {
		align-self: stretch;
		margin-top: var(--space-2);
	}

	.booking__again {
		margin-top: var(--space-2);
		padding: 13px 23px;
		border: 1px solid var(--color-burnt-orange);
		border-radius: 2px;
