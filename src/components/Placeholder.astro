---

interface Props {
    placeholderText?: string;
    background?: "WHITE" | "BLACK";
}

const {
    placeholderText = 'CONTENT',
    background = "WHITE",
} = Astro.props;

---

<section
    class={
        background === "WHITE" ? "placeholder-section placeholder-section--white" : "placeholder-section placeholder-section--black"
    }
>
    { placeholderText }
</section>


<style>
    .placeholder-section {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: clamp(2.5rem, 8vw, 6rem);
    }

    .placeholder-section--white {
        background: var(--color-title);
        color: var(--color-burnt-orange);
    }

    .placeholder-section--black {
        background: var(--color-black-pearl);
        color: var(--color-title);
    }
</style>