---
import Layout from "../layouts/Layout.astro";
import HeroLine from "../components/HeroLine";
import HeroR3F from "../components/HeroR3F";
import HeroWave3D from "../components/HeroWave3D";
import Placeholder from "../components/Placeholder.astro";
import {ImageContainer} from "../components/ImageContainer";
import { NavBar } from "../components/NavBar";
import PlayPauseIcon from "../components/PlayPauseIcon";
import AboutBioBlock from "../components/AboutBioBlock.astro";
---

<Layout>
	<NavBar links={['Главная', 'Миксы', 'О себе', 'Ивенты', 'Контакты']} client:idle />
	<!-- вне #page-shell намеренно: это position:fixed элемент, а transform на
	предке меняет его containing block — если оставить его внутри сдвигаемой
	обёртки, "LEVITI" укатится вместе со страницей при открытом мобильном меню -->
	<h1 class="hero__title hero__title--pinned" id="hero-title">LEVITI</h1>
	<div id="page-shell">
	<section class="hero is-animating" id="hero">
		<!--<HeroLine client:load />-->
		<!--<HeroR3F client:load />-->
		<HeroWave3D client:load />

		<div class="hero__content">
			<p class="hero__eyebrow">event &amp; club dj · москва / тула</p>
			<div class="hero__title hero__title-ghost" id="hero-title-ghost" aria-hidden="true">LEVITI</div>
			<p class="hero__desc">
				UK garage, house, bass music и авторские эдиты. Программа собирается под
				площадку и аудиторию — от тонплея до скретча.
			</p>
			<div class="hero__actions">
				<button id="test-play" class="hero__mix-btn"> <PlayPauseIcon playing={false} /> Слушать миксы</button>
			</div>
		</div>
	</section>

	<Placeholder background="BLACK" placeholderText="MIXES" />

	<section class="about-me">
		<svg class="about-me__bg-mark" aria-hidden="true" focusable="false">
			<text x="0" y="50%" dominant-baseline="middle">KOVALEVA</text>
		</svg>
		<div class="about-me__info">
			<h1 class="about-me__title">
				ОЛЬГА<br />
				<span class="about-me__accent">КОВАЛЕВА</span>
			</h1>

			<div class="about-me__stats">
				<span>3 года за пультом</span>
				<span>1 год в индустрии</span>
				<span>лауреат премии</span>
			</div>

			<AboutBioBlock />
		</div>
		<div class="about-me__photos">
			<ImageContainer
				src="/photo/dj.jpg"
				alt="фото Оли 1"
				description="REC · 01/06"
			/>
			<ImageContainer
				src="/photo/InCollage_20260915_215629068.png"
				alt="фото Оли 2"
				description="REC · 02/06"
			/>
			<ImageContainer
				src="/photo/Левити_50.jpg"
				alt="фото Оли 3"
				description="REC · 03/06"
			/>
			<ImageContainer
				src="/photo/Левити_51.JPG"
				alt="фото Оли 4"
				description="REC · 04/06"
			/>
			<ImageContainer
				src="/photo/Левити_64.jpg"
				alt="фото Оли 5"
				description="REC · 05/06"
			/>
			<ImageContainer
				src="/photo/Левити_156.jpg"
				alt="фото Оли 6"
				description="REC · 06/06"
			/>
			<!--<ImageContainer-->
			<!--	src="/photo/Левити_214 (1).jpg"-->
			<!--	alt="фото Оли 7"-->
			<!--	description="REC · 07/08"-->
			<!--/>-->
			<!--<ImageContainer-->
			<!--	src="/photo/Левити_228.jpg"-->
			<!--	alt="фото Оли 8"-->
			<!--	description="REC · 08/08"-->
			<!--/>-->
		</div>
	</section>

	<Placeholder background="BLACK" placeholderText="EVENTS" />

	<Placeholder background="BLACK" placeholderText="BOOKING"/>
	</div>

</Layout>

<script>
	import { playTrack } from "../stores/player";
	import Lenis from "lenis";
	import gsap from "gsap";

	document.getElementById("test-play")?.addEventListener("click", () => {
		playTrack({ url: "/audio/test-gergert.mp3", title: "Test Mix" });
	});

	const hero = document.getElementById("hero");
	const title = document.getElementById("hero-title");
	const heroTitleGhost = document.getElementById("hero-title-ghost");
	const restElements = [
		document.querySelector(".hero__eyebrow"),
		document.querySelector(".hero__desc"),
		document.querySelector(".hero__actions"),
	];
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const easeInOutQuint = (t: number) =>
		t < 0.5
				? 16 * t * t * t * t * t
				: 1 - Math.pow(-2 * t + 2, 5) / 2;

	// titleStartRect — «родная» позиция заголовка в hero, берётся с невидимого
	// спейсера (heroTitleGhost), который всегда в нормальном потоке. Сам #hero-title
	// зафиксирован (position: fixed) и своей собственной getBoundingClientRect()
	// ничего полезного не даст — она всегда «привязана» к left:0; top:0.
	let titleStartRect: DOMRect | null = null;
	let titleTargetRect: DOMRect | null = null;
	let introDone = false;

	function measureStickyTitle() {
		if (!heroTitleGhost) return;
		const ghostRect = heroTitleGhost.getBoundingClientRect();
		// ghost — обычный элемент в потоке; если измерение попадёт на момент, когда
		// страница уже прокручена (например, resize на секции ниже), приводим rect
		// к тому виду, какой он имел бы при scrollY = 0 — иначе вся арифметика
		// стыковки ниже поедет
		titleStartRect = new DOMRect(
			ghostRect.left,
			ghostRect.top + window.scrollY,
			ghostRect.width,
			ghostRect.height,
		);
		const navSlot = document.getElementById("navbar-logo-slot");
		if (navSlot) titleTargetRect = navSlot.getBoundingClientRect();
	}

	// Пока заголовок ещё не пристыковался к навбару, он визуально — часть
	// содержимого hero (просто вынесен из #page-shell из-за position:fixed +
	// containing block), поэтому при открытии мобильного меню должен уезжать
	// влево вместе со страницей. Как только он осел в баре как логотип —
	// становится частью самого бара и меню его больше не трогает.
	const menuShiftState = { v: 0 };

	function applyStickyTitle(scrollY: number) {
		if (!title || !titleStartRect || !titleTargetRect) return;

		// Настоящий sticky: заголовок — не "плавающий над страницей" элемент с
		// собственной кривой анимации, а ведёт себя как обычный (не fixed) элемент —
		// едет вместе со страницей 1:1 — до тех пор, пока его родная позиция не
		// долетит ровно до места в навбаре. dockThreshold — это и есть тот момент
		// "навбар дотянулся до надписи". Формула симметрична сама по себе, поэтому
		// отдельного кода для скролла вверх не нужно — при уменьшении scrollY всё
		// просто проигрывается в обратную сторону.
		const dockThreshold = titleStartRect.top - titleTargetRect.top;

		if (scrollY <= dockThreshold) {
			const y = titleStartRect.top - scrollY;
			const x = titleStartRect.left - menuShiftState.v;
			title.style.transform = `translate(${x}px, ${y}px) scale(1)`;
			return;
		}

		// «подхвачен» навбаром — дальше не едет вместе со страницей, а стыкуется
		// на месте и на оставшемся участке скролла ужимается до нужного размера
		const remaining = window.innerHeight - dockThreshold;
		const p = remaining > 0
			? Math.min(Math.max((scrollY - dockThreshold) / remaining, 0), 1)
			: 1;
		const eased = p * p * (3 - 2 * p); // smoothstep, только для самого превращения

		const scale = 1 + (titleTargetRect.width / titleStartRect.width - 1) * eased;
		const x = titleStartRect.left + (titleTargetRect.left - titleStartRect.left) * eased;

		title.style.transform = `translate(${x}px, ${titleTargetRect.top}px) scale(${scale})`;
	}

	measureStickyTitle();
	window.addEventListener("resize", measureStickyTitle);
	// шрифт Archivo грузится асинхронно — если он подъедет после первого замера,
	// пересчитываем rect, иначе стартовая позиция может быть на пиксель-другой мимо
	document.fonts?.ready?.then(measureStickyTitle);

	// Проявляет переданные элементы по очереди (stagger), полностью через JS —
	// без CSS-класса с keyframe-анимацией, чтобы не словить "флеш" полностью
	// видимого состояния за кадр до старта анимации.
	function revealStagger(elements, staggerMs = 150) {
		// 1. явно фиксируем текущее скрытое состояние инлайн-стилем (то же самое,
		// что раньше держал CSS-класс is-animating) — дальше им управляем сами
		elements.forEach((el) => {
			if (!el) return;
			el.style.transition = "none";
			el.style.opacity = "0";
			el.style.transform = "translateY(16px)";
		});

		hero?.classList.remove("is-animating");
		hero?.classList.add("is-landed");

		// 2. два вложенных rAF — гарантия, что браузер успел отрисовать кадр
		// со скрытым состоянием, прежде чем мы включим transition
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				elements.forEach((el, i) => {
					if (!el) return;
					const delay = `${i * staggerMs}ms`;
					el.style.transition = `opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1) ${delay}, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) ${delay}`;
					el.style.opacity = "1";
					el.style.transform = "translateY(0)";
				});
			});
		});
	}

	if (hero && title && titleStartRect) {
		const startRect = titleStartRect;

		if (prefersReducedMotion) {
			hero.classList.remove("is-animating");
			hero.classList.add("is-landed");
			title.style.transform = `translate(${startRect.left}px, ${startRect.top}px) scale(1)`;
			introDone = true;
		} else {
			// прячем заголовок, пока не измерили его настоящую (финальную) позицию —
			// иначе на один кадр мелькнёт в правильном месте до того, как мы его "телепортируем"
			title.style.visibility = "hidden";

			requestAnimationFrame(() => {
				const viewportCenterX = window.innerWidth / 2;
				const viewportCenterY = window.innerHeight / 2;

				const startScale = 1.7; // насколько крупнее заголовок в стартовой точке
				// transform-origin у #hero-title — top left, поэтому рост масштаба идёт
				// от угла, а не от центра: компенсируем это половиной прироста размера,
				// чтобы визуально центр укрупнённого заголовка совпал с центром экрана
				const startWidth = startRect.width * startScale;
				const startHeight = startRect.height * startScale;
				const startX = viewportCenterX - startWidth / 2;
				const startY = viewportCenterY - startHeight / 2;

				// мгновенно (без transition) ставим заголовок в стартовую позицию —
				// крупно и по центру экрана. Это тот же самый элемент, просто временно
				// визуально смещённый transform'ом
				title.style.transform = `translate(${startX}px, ${startY}px) scale(${startScale})`;
				title.style.opacity = "0";
				title.style.visibility = "visible";

				requestAnimationFrame(() => {
					// проявляем на месте (пока без движения)
					title.style.transition = "opacity 0.5s ease";
					title.style.opacity = "1";

					// пауза, затем — полёт в реальную позицию (совпадает с startRect)
					setTimeout(() => {
						title.style.transition = "transform 1.1s cubic-bezier(0.16, 1, 0.3, 1)";
						title.style.transform = `translate(${startRect.left}px, ${startRect.top}px) scale(1)`;
					}, 500);
				});
			});

			title.addEventListener("transitionend", function onDone(e) {
				if (e.propertyName !== "transform") return;
				title.removeEventListener("transitionend", onDone);
				title.style.transition = "";
				introDone = true;
				revealStagger(restElements);
			});
		}
	}

	const lenis = new Lenis({
		duration: 1.2,
		easing: easeInOutQuint,
	});

	function raf(time) {
		lenis.raf(time);
		if (introDone) applyStickyTitle(lenis.scroll);
		requestAnimationFrame(raf);
	}

	requestAnimationFrame(raf);

	console.log('lenis is: ', lenis);

	lenis.stop();

	const sections = Array.from(document.querySelectorAll("section"));
	let currentIndex = 0;
	let isAnimating = false;

	function isAboutSection(index: number) {
		return sections[index]?.classList.contains("about-me") ?? false;
	}

	// на узких экранах ширина макета определяет и раскладку (CSS-медиазапрос
	// на 700px), и то, включена ли ниже логика переключения стопов — держим
	// оба на одном брейкпоинте
	function isCompactLayout() {
		return window.matchMedia("(max-width: 700px)").matches;
	}

	// мобильный "стоп" внутри секции "о себе": текст -> фото, лежат друг на
	// друге (см. CSS про .about-me__info/.about-me__photos в @media 700px) и
	// переключаются тем же тиком скролла/свайпа, что листает секции страницы.
	// На десктопе (isCompactLayout() === false) эта пара вообще не трогается —
	// там текст и фото это просто обычный поток, см. базовые стили .about-me.
	const aboutStops = [
		document.querySelector<HTMLElement>(".about-me__info"),
		document.querySelector<HTMLElement>(".about-me__photos"),
	].filter((el): el is HTMLElement => el !== null);
	let aboutStopIndex = 0;
	let aboutStopAnimating = false;

	// внутри фото-стопа — свой горизонтальный трек отдельных фото, той же
	// анимацией/easing, что и переключение текст<->фото ниже
	const aboutPhotoSlides = Array.from(
		document.querySelectorAll<HTMLElement>(".about-me__photos .js-about-photo")
	);
	let aboutPhotoIndex = 0;
	let aboutPhotoAnimating = false;

	function setAboutPhotoInstant(index: number) {
		aboutPhotoIndex = Math.max(0, Math.min(index, aboutPhotoSlides.length - 1));
		aboutPhotoSlides.forEach((el, i) => {
			gsap.set(el, {
				xPercent: i === aboutPhotoIndex ? 0 : i < aboutPhotoIndex ? -100 : 100,
				pointerEvents: i === aboutPhotoIndex ? "auto" : "none",
			});
		});
	}

	// начальное состояние выставляем один раз сразу — дальше индекс не
	// сбрасывается ни при переключении стопов, ни при уходе/возврате в
	// секцию (см. goToSection/showAboutStop): пользователь должен вернуться
	// ровно на то фото, где остановился
	setAboutPhotoInstant(0);

	function showAboutPhoto(nextIndex: number) {
		if (aboutPhotoAnimating || nextIndex === aboutPhotoIndex) return;
		if (nextIndex < 0 || nextIndex > aboutPhotoSlides.length - 1) return;

		const current = aboutPhotoSlides[aboutPhotoIndex];
		const next = aboutPhotoSlides[nextIndex];
		const goingForward = nextIndex > aboutPhotoIndex;
		const duration = prefersReducedMotion ? 0 : 0.9;

		aboutPhotoAnimating = true;
		gsap.set(next, { xPercent: goingForward ? 100 : -100, pointerEvents: "none" });

		gsap.timeline({
			defaults: { duration, ease: easeInOutQuint },
			onComplete: () => {
				gsap.set(current, { pointerEvents: "none" });
				gsap.set(next, { pointerEvents: "auto" });
				aboutPhotoAnimating = false;
			},
		})
			.to(current, { xPercent: goingForward ? -100 : 100 }, 0)
			.to(next, { xPercent: 0 }, 0);

		aboutPhotoIndex = nextIndex;
	}

	function setAboutStopInstant(index: number) {
		aboutStopIndex = Math.max(0, Math.min(index, aboutStops.length - 1));
		aboutStops.forEach((el, i) => {
			gsap.set(el, {
				xPercent: i === aboutStopIndex ? 0 : i < aboutStopIndex ? -100 : 100,
				zIndex: i === aboutStopIndex ? 2 : 1,
				pointerEvents: i === aboutStopIndex ? "auto" : "none",
			});
		});
	}

	if (isCompactLayout()) setAboutStopInstant(0);

	// если ширина экрана переходит через 700px (ресайз окна, поворот
	// телефона) — либо выставляем стопы заново под мобильный режим, либо
	// снимаем инлайн-стили, чтобы не мешать обычному desktop-потоку
	// ===== десктоп (не адаптив) =====
	// раньше на каждый тик скролла вниз/вверх по секции "о себе" на десктопе
	// менялось текущее фото (вертикальный кроссфейд) — эффект потерялся,
	// когда секцию упростили в обычный поток со статичной сеткой миниатюр.
	// Восстанавливаем его тут отдельно от мобильной карусели выше — те же
	// DOM-узлы (.js-about-photo), но полностью свой набор состояния и своя
	// анимация (yPercent вместо xPercent), не пересекается с мобильной вообще,
	// т.к. включается только при !isCompactLayout()
	const aboutPhotosDesktop = Array.from(
		document.querySelectorAll<HTMLElement>(".about-me__photos .js-about-photo")
	);
	let desktopPhotoIndex = 0;
	let desktopPhotoAnimating = false;

	function setDesktopPhotoInstant(index: number) {
		desktopPhotoIndex = Math.max(0, Math.min(index, aboutPhotosDesktop.length - 1));
		aboutPhotosDesktop.forEach((el, i) => {
			gsap.set(el, {
				yPercent: 0,
				opacity: i === desktopPhotoIndex ? 1 : 0,
				pointerEvents: i === desktopPhotoIndex ? "auto" : "none",
			});
		});
	}

	if (!isCompactLayout()) setDesktopPhotoInstant(0);

	function showDesktopPhoto(nextIndex: number) {
		if (desktopPhotoAnimating || nextIndex === desktopPhotoIndex) return;
		if (nextIndex < 0 || nextIndex > aboutPhotosDesktop.length - 1) return;

		const current = aboutPhotosDesktop[desktopPhotoIndex];
		const next = aboutPhotosDesktop[nextIndex];
		const goingForward = nextIndex > desktopPhotoIndex;
		const duration = prefersReducedMotion ? 0 : 1.2;

		desktopPhotoAnimating = true;
		gsap.set(next, { opacity: 0, yPercent: goingForward ? 100 : -100, pointerEvents: "none" });

		gsap.timeline({
			defaults: { duration, ease: easeInOutQuint },
			onComplete: () => {
				gsap.set(current, { pointerEvents: "none" });
				gsap.set(next, { pointerEvents: "auto" });
				desktopPhotoAnimating = false;
			},
		})
			.to(current, { yPercent: goingForward ? -100 : 100, opacity: 0 }, 0)
			.to(next, { yPercent: 0, opacity: 1 }, 0);

		desktopPhotoIndex = nextIndex;
	}

	function handleAboutDesktopScroll(direction: 1 | -1): boolean {
		const next = desktopPhotoIndex + direction;
		if (next < 0 || next > aboutPhotosDesktop.length - 1) return false;
		showDesktopPhoto(next);
		return true;
	}

	// на десктопе фото листаются только пока курсор реально над блоком с
	// фото — если он снаружи, колесо просто листает секции страницы как
	// обычно, не подхватывая фото-логику
	const aboutPhotosBlock = document.querySelector<HTMLElement>(".about-me__photos");
	let isHoveringAboutPhotos = false;
	aboutPhotosBlock?.addEventListener("mouseenter", () => { isHoveringAboutPhotos = true; });
	aboutPhotosBlock?.addEventListener("mouseleave", () => { isHoveringAboutPhotos = false; });

	let wasCompactLayout = isCompactLayout();
	window.addEventListener("resize", () => {
		const compactNow = isCompactLayout();
		if (compactNow === wasCompactLayout) return;
		wasCompactLayout = compactNow;
		if (compactNow) {
			gsap.set(aboutPhotosDesktop, { clearProps: "transform,opacity,pointerEvents" });
			setAboutStopInstant(0);
		} else {
			gsap.set(aboutStops, { clearProps: "transform,zIndex,pointerEvents" });
			gsap.set(aboutPhotoSlides, { clearProps: "transform,pointerEvents" });
			setDesktopPhotoInstant(0);
		}
	});

	function showAboutStop(nextIndex: number) {
		if (aboutStopAnimating || nextIndex === aboutStopIndex) return;
		if (nextIndex < 0 || nextIndex > aboutStops.length - 1) return;

		const current = aboutStops[aboutStopIndex];
		const next = aboutStops[nextIndex];
		const goingForward = nextIndex > aboutStopIndex;
		const duration = prefersReducedMotion ? 0 : 0.9;

		aboutStopAnimating = true;
		gsap.set(next, { xPercent: goingForward ? 100 : -100, zIndex: 2, pointerEvents: "none" });

		gsap.timeline({
			defaults: { duration, ease: easeInOutQuint },
			onComplete: () => {
				gsap.set(current, { zIndex: 1, pointerEvents: "none" });
				gsap.set(next, { pointerEvents: "auto" });
				aboutStopAnimating = false;
			},
		})
			.to(current, { xPercent: goingForward ? -100 : 100 }, 0)
			.to(next, { xPercent: 0 }, 0);

		aboutStopIndex = nextIndex;
	}

	// возвращает "inner", если стоп сам не докручен до конца в эту сторону
	// (даём ему доскроллиться естественно, прежде чем переключать что-то),
	// "stop" — переключили стоп внутри секции, "section" — стопы кончились,
	// пусть вызывающий код переходит к соседней секции страницы
	function handleAboutMobileScroll(direction: 1 | -1): "inner" | "stop" | "section" {
		const el = aboutStops[aboutStopIndex];
		if (el) {
			const atEnd = direction > 0
				? el.scrollHeight - el.scrollTop - el.clientHeight < 2
				: el.scrollTop < 2;
			if (!atEnd) return "inner";
		}

		const next = aboutStopIndex + direction;
		if (next < 0 || next > aboutStops.length - 1) return "section";

		showAboutStop(next);
		return "stop";
	}

	function goToSection(index: number) {
		const target = Math.max(0, Math.min(index, sections.length - 1));
		if (target === currentIndex || isAnimating) return;

		isAnimating = true;
		currentIndex = target;
		window.dispatchEvent(new CustomEvent('nav:active', { detail: { index: currentIndex } }));

		// стоп/индекс текущего фото в "о себе" намеренно не сбрасываем при
		// входе/выходе из секции — пользователь должен вернуться ровно туда,
		// где остановился, независимо от того, куда потом скроллил

		lenis.scrollTo(sections[currentIndex], {
			duration: 1.2,
			easing: easeInOutQuint,
			force: true,
			lock: true,
			onComplete: () => {
				setTimeout(() => {
					isAnimating = false;
				}, 250);
			},
		})
	}

	window.addEventListener('nav:goto', (e: Event) => {
		const { index } = (e as CustomEvent<{index: number}>).detail;
		goToSection(index);
	})

	// «выдвижное» мобильное меню в NavBar сообщает о своём состоянии сюда —
	// страница отъезжает влево (см. CSS #page-shell), открывая панель меню
	const pageShell = document.getElementById("page-shell");
	const mobileMenuEl = document.querySelector<HTMLElement>("[data-mobile-menu]");

	window.addEventListener('nav:menu', (e: Event) => {
		const { open } = (e as CustomEvent<{ open: boolean }>).detail;
		pageShell?.classList.toggle("is-menu-open", open);

		// ширина панели меню фиксирована (var(--menu-width)), меняется только её
		// translateX — поэтому актуальную ширину можно смело брать сразу, не
		// дожидаясь конца CSS-перехода
		const target = open ? (mobileMenuEl?.getBoundingClientRect().width ?? 0) : 0;
		gsap.killTweensOf(menuShiftState);
		gsap.to(menuShiftState, { v: target, duration: 0.4, ease: "expo.out" });
	})

	window.addEventListener("wheel", (e) => {
		const horizontalDominant = Math.abs(e.deltaX) > Math.abs(e.deltaY);

		if (isAboutSection(currentIndex) && isCompactLayout()) {
			// горизонтальный жест на фото-стопе — это свой трек отдельных фото
			// (см. aboutPhotoSlides выше), к переключению текст<->фото или
			// смене секции отношения не имеет
			if (horizontalDominant) {
				if (aboutStopIndex === 1 && !aboutPhotoAnimating) {
					e.preventDefault();
					showAboutPhoto(aboutPhotoIndex + (e.deltaX > 0 ? 1 : -1));
				}
				return;
			}

			// стоп (или фото-стоп) ещё анимируется — глотаем событие целиком,
			// иначе одно физическое движение колеса/трекпада шлёт много
			// wheel-событий подряд, и следующее из них застаёт уже
			// переключившийся aboutStopIndex и тут же уводит на следующую
			// секцию страницы — тот самый баг с авто-прыжком на фото
			if (isAnimating || aboutStopAnimating) {
				e.preventDefault();
				return;
			}

			const direction = e.deltaY > 0 ? 1 : -1;
			const result = handleAboutMobileScroll(direction);
			// "inner" — стоп сам не докручен, отдаём событие браузеру нативно
			// проскроллить его дальше, ничего не перехватываем
			if (result === "inner") return;
			e.preventDefault();
			if (result === "stop") return;
			goToSection(currentIndex + direction);
			return;
		}

		if (horizontalDominant) return;
		e.preventDefault();
		if (isAnimating) return;

		const direction = e.deltaY > 0 ? 1 : -1;

		// десктоп + секция "о себе" + курсор реально над фото — сначала
		// пролистываем их по одному, и только когда они кончились, уходим на
		// соседнюю секцию страницы. Если курсор не над фото — колесо сразу
		// листает секции, фото не трогает
		if (isAboutSection(currentIndex) && !isCompactLayout() && isHoveringAboutPhotos) {
			if (desktopPhotoAnimating) return;
			if (handleAboutDesktopScroll(direction)) return;
		}

		goToSection(currentIndex + direction);
	}, {passive: false});

	let touchStartX = 0;
	let touchStartY = 0;

	window.addEventListener("touchstart", (e: TouchEvent) => {
		touchStartX = e.touches[0].clientX;
		touchStartY = e.touches[0].clientY;
	}, {passive: true});

	window.addEventListener("touchend", (e: TouchEvent) => {
		const deltaX = touchStartX - e.changedTouches[0].clientX;
		const deltaY = touchStartY - e.changedTouches[0].clientY;
		const horizontalDominant = Math.abs(deltaX) > Math.abs(deltaY);

		if (isAboutSection(currentIndex) && isCompactLayout()) {
			if (horizontalDominant) {
				if (Math.abs(deltaX) < 30) return;
				if (aboutStopIndex === 1 && !aboutPhotoAnimating) {
					showAboutPhoto(aboutPhotoIndex + (deltaX > 0 ? 1 : -1));
				}
				return;
			}

			if (Math.abs(deltaY) < 30) return;
			if (isAnimating || aboutStopAnimating) return;
			// к моменту touchend нативный скролл внутри стопа (если был) уже
			// применился сам — просто проверяем, докручен ли стоп до конца
			const direction = deltaY > 0 ? 1 : -1;
			const result = handleAboutMobileScroll(direction);
			if (result !== "section") return;
			goToSection(currentIndex + direction);
			return;
		}

		if (horizontalDominant) return;
		if (Math.abs(deltaY) < 30) return;
		if (isAnimating) return;

		const direction = deltaY > 0 ? 1 : -1;

		if (isAboutSection(currentIndex) && !isCompactLayout()) {
			if (desktopPhotoAnimating) return;
			if (handleAboutDesktopScroll(direction)) return;
		}

		goToSection(currentIndex + direction);
	}, {passive: true});

</script>

